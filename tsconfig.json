{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["bun", "node"],
    "baseUrl": ".",
    "paths": {
      "@freepi/shared": ["./src/vendor/shared/index.ts"],
      "@freepi/pi-ads": ["./src/vendor/pi-ads/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
